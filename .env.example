# =============================================================================
# COMPAWSS AI - ENVIRONMENT VARIABLES
# =============================================================================
# Copy this file to .env.local and fill in your actual API keys
# =============================================================================

# -----------------------------------------------------------------------------
# REQUIRED API KEYS (Backend will not work without these)
# -----------------------------------------------------------------------------

# Gemini API Key - Required for ALL AI features (chat, image analysis, recommendations)
# Get from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY="your_gemini_api_key_here"

# Alternative AI Model API Key (if using different AI provider)
# Currently supports Gemini, but can be extended for other models
AI_MODEL_API_KEY="your_ai_model_api_key_here"

# -----------------------------------------------------------------------------
# SUPABASE DATABASE (Required for NGO/Rescue Case Data)
# -----------------------------------------------------------------------------

# Supabase Project URL
# Get from: https://supabase.com/dashboard → Settings → API → Project URL
SUPABASE_URL="https://your-project.supabase.co"

# Supabase Anonymous Key (Public Key)
# Get from: https://supabase.com/dashboard → Settings → API → Project API keys → anon/public
SUPABASE_ANON_KEY="your_supabase_anon_key_here"

# Supabase Service Role Key (Private Key - Backend Only)
# Get from: https://supabase.com/dashboard → Settings → API → Project API keys → service_role
# WARNING: Keep this secret! Never expose in frontend code
SUPABASE_SERVICE_ROLE_KEY="your_supabase_service_role_key_here"

# Frontend Supabase Config (same as above, prefixed with VITE_ for Vite access)
VITE_SUPABASE_URL="https://your-project.supabase.co"
VITE_SUPABASE_ANON_KEY="your_supabase_anon_key_here"

# -----------------------------------------------------------------------------
# GOOGLE MAPS & PLACES API (For Location Services)
# -----------------------------------------------------------------------------

# Google Places API Key - For backend veterinary clinic data fetching
# Get from: https://console.cloud.google.com/ → APIs & Services → Credentials
# Enable: Places API, Geocoding API
GOOGLE_PLACES_API_KEY="your_google_places_api_key_here"

# Google Maps Platform Key (for frontend map display and Places API)
# Get from: https://console.cloud.google.com/ → APIs & Services → Credentials
# Enable: Maps JavaScript API, Places API (New)
# IMPORTANT: This key is exposed to the frontend, so set appropriate restrictions
GOOGLE_MAPS_PLATFORM_KEY="your_google_maps_platform_key_here"

# Frontend Google Maps API Key (prefixed with VITE_ for Vite access)
# Use the SAME key as GOOGLE_MAPS_PLATFORM_KEY above
# This is used by the frontend to load Google Maps JavaScript API
VITE_GOOGLE_MAPS_API_KEY="your_google_maps_platform_key_here"

# -----------------------------------------------------------------------------
# BACKEND CONFIGURATION
# -----------------------------------------------------------------------------

# Python AI Backend URL (for frontend to connect to)
# Development: http://localhost:8000
# Production: https://your-backend.onrender.com or your deployed URL
VITE_AI_BACKEND_URL="http://localhost:8000"

# NGO Directory API URL (if using external NGO directory service)
# Leave empty to use Supabase database instead
NGO_DIRECTORY_API_URL=""

# -----------------------------------------------------------------------------
# APPLICATION SETTINGS
# -----------------------------------------------------------------------------

# Demo Mode - Set to "true" to enable demo data when APIs unavailable
# Set to "false" for production (strict mode - returns errors if data missing)
# Default: false (production mode)
DEMO_MODE="false"

# App URL (for OAuth callbacks, webhooks, etc.)
# Development: http://localhost:5173
# Production: https://your-app-domain.com
APP_URL="http://localhost:5173"

# Environment
# Options: development, staging, production
ENV="development"

# -----------------------------------------------------------------------------
# OPTIONAL / FUTURE FEATURES
# -----------------------------------------------------------------------------

# Firebase Config (not currently used, reserved for future authentication)
FIREBASE_CONFIG=""

# Twilio API (for SMS notifications - future feature)
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_PHONE_NUMBER=""

# SendGrid API (for email notifications - future feature)
SENDGRID_API_KEY=""

# Cloudinary (for image storage - future feature)
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# -----------------------------------------------------------------------------
# NOTES
# -----------------------------------------------------------------------------
# 
# PRIORITY SETUP ORDER:
# 1. GEMINI_API_KEY (Required - nothing works without this)
# 2. SUPABASE_URL + SUPABASE_ANON_KEY (Required for data storage)
# 3. VITE_AI_BACKEND_URL (Required for frontend-backend communication)
# 4. GOOGLE_PLACES_API_KEY (Recommended for real vet data)
# 5. GOOGLE_MAPS_PLATFORM_KEY (Recommended for map display)
# 6. All other keys are optional
#
# SECURITY REMINDERS:
# - Never commit .env.local to git (already in .gitignore)
# - Keep SUPABASE_SERVICE_ROLE_KEY secret (backend only)
# - Rotate keys regularly
# - Use different keys for development and production
#
# TESTING:
# - Set DEMO_MODE="true" for testing without real API keys
# - Set DEMO_MODE="false" for production deployment
#
